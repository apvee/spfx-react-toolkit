{
  "name": "@apvee/spfx-react-toolkit",
  "version": "2.1.0",
  "description": "Comprehensive React runtime and hooks library for SharePoint Framework (SPFx)",
  "private": false,
  "engines": {
    "node": ">=22.14.0 < 23.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/index.*",
    "lib/core/**/*",
    "lib/hooks/**/*",
    "lib/services/**/*",
    "lib/helpers/**/*",
    "lib/utils/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('lib', {recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "node --test ../../tests/provider-storage.test.cjs ../../tests/async-hooks.test.cjs ../../tests/services.test.cjs",
    "prepublishOnly": "npm run clean && npm run build && npm run lint && npm test"
  },
  "devDependencies": {
    "@microsoft/sp-application-base": "1.21.1",
    "@microsoft/sp-component-base": "1.21.1",
    "@microsoft/sp-core-library": "1.21.1",
    "@microsoft/sp-http": "1.21.1",
    "@microsoft/sp-listview-extensibility": "1.21.1",
    "@microsoft/sp-page-context": "1.21.1",
    "@microsoft/sp-webpart-base": "1.21.1",
    "@pnp/core": "4.17.0",
    "@pnp/queryable": "4.17.0",
    "@pnp/sp": "4.17.0",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "typescript": "5.3.3",
    "@types/react": "17.0.45",
    "@types/react-dom": "17.0.17",
    "@fluentui/react-migration-v8-v9": "^9.9.12",
    "@fluentui/react-theme": "^9.2.0",
    "@fluentui/react-utilities": "^9.25.1",
    "@griffel/core": "1.19.2",
    "@griffel/react": "1.5.30",
    "@fluentui/react-shared-contexts": "9.25.2"
  },
  "peerDependencies": {
    "@microsoft/sp-application-base": ">=1.18.0 <2.0.0",
    "@microsoft/sp-component-base": ">=1.18.0 <2.0.0",
    "@microsoft/sp-core-library": ">=1.18.0 <2.0.0",
    "@microsoft/sp-http": ">=1.18.0 <2.0.0",
    "@microsoft/sp-listview-extensibility": ">=1.18.0 <2.0.0",
    "@microsoft/sp-page-context": ">=1.18.0 <2.0.0",
    "@microsoft/sp-webpart-base": ">=1.18.0 <2.0.0",
    "@pnp/core": "^4.0.0",
    "@pnp/queryable": "^4.0.0",
    "@pnp/sp": "^4.0.0",
    "react": "17.x",
    "react-dom": "17.x",
    "@fluentui/react-migration-v8-v9": "^9.9.12",
    "@fluentui/react-theme": "^9.2.0",
    "@fluentui/react-utilities": "^9.25.1",
    "@griffel/core": "^1.19.2",
    "@griffel/react": "^1.5.30",
    "@fluentui/react-shared-contexts": "^9.25.2"
  },
  "homepage": "https://github.com/apvee/spfx-react-toolkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apvee/spfx-react-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/apvee/spfx-react-toolkit/issues"
  },
  "author": "Apvee Solutions",
  "license": "MIT",
  "keywords": [
    "sharepoint",
    "spfx",
    "sharepoint-framework",
    "react",
    "hooks",
    "typescript",
    "office365",
    "microsoft365",
    "m365",
    "webpart",
    "extension",
    "commandset",
    "field-customizer",
    "application-customizer",
    "pnp",
    "pnpjs",
    "context",
    "state-management"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
