{
  "schemaVersion": 1,
  "moduleGroups": {
    "pnp": [
      "^@pnp/"
    ],
    "styles-engine": [
      "^@apvee/spfx-react-toolkit/lib/helpers/styles/(resolve|renderer|cache|bindings)\\.internal\\.js$"
    ],
    "toolkit": [
      "^@apvee/spfx-react-toolkit/"
    ],
    "spfx-runtime": [
      "^@microsoft/sp-"
    ],
    "list-registration": [
      "^@pnp/sp/(lists|items)/"
    ],
    "search-registration": [
      "^@pnp/sp/search/"
    ],
    "batch-registration": [
      "^@pnp/sp/batching\\.js$"
    ],
    "griffel": [
      "^@griffel/"
    ],
    "style-descriptors": [
      "^@apvee/spfx-react-toolkit/lib/helpers/styles/"
    ],
    "fluent-style": [
      "^@fluentui/react-(theme|migration-v8-v9)/"
    ],
    "provider": [
      "^@apvee/spfx-react-toolkit/lib/core/(provider[^/]*|context\\.internal|state\\.internal)\\.js$"
    ],
    "theme-conversion": [
      "^@apvee/spfx-react-toolkit/lib/(helpers/spfx-theme|hooks/useSPFxTheme)"
    ],
    "typography": [
      "^@apvee/spfx-react-toolkit/lib/helpers/styles/typography\\.js$",
      "^@fluentui/react-theme/"
    ],
    "formatted-text": [
      "^@apvee/spfx-react-toolkit/lib/controls/formatted-text/"
    ],
    "markdown": [
      "^(unified|remark-[^/]+|micromark[^/]*|mdast-util-[^/]+|vfile[^/]*|unist-util-[^/]+)/"
    ],
    "fluent-link": [
      "^@fluentui/react-link/"
    ],
    "relative-time": [
      "^@apvee/spfx-react-toolkit/lib/controls/relative-time/"
    ],
    "iana-lookup": [
      "^@apvee/spfx-react-toolkit/lib/helpers/spfx-time-zone\\.internal\\.js$"
    ],
    "fluent-tooltip": [
      "^@fluentui/react-tooltip/"
    ],
    "auto-skeleton": [
      "^@apvee/spfx-react-toolkit/lib/controls/auto-skeleton/"
    ],
    "fluent-skeleton": [
      "^@fluentui/react-skeleton/"
    ],
    "styles-compiler": [
      "^@apvee/spfx-react-toolkit/lib/helpers/styles/(resolve|cache|bindings)\\.internal\\.js$"
    ],
    "state-message": [
      "^@apvee/spfx-react-toolkit/lib/controls/state-message/"
    ],
    "state-artwork": [
      "^@apvee/spfx-react-toolkit/lib/controls/state-message/illustrations/"
    ],
    "fluent-button": [
      "^@fluentui/react-button/"
    ],
    "settings-group": [
      "^@apvee/spfx-react-toolkit/lib/controls/settings-group/"
    ],
    "accordion-group": [
      "^@apvee/spfx-react-toolkit/lib/controls/accordion-group/"
    ],
    "fluent-card": [
      "^@fluentui/react-card/"
    ],
    "fluent-accordion": [
      "^@fluentui/react-accordion/"
    ],
    "form": [
      "^@apvee/spfx-react-toolkit/lib/controls/form/"
    ],
    "react-hook-form": [
      "^react-hook-form/"
    ],
    "form-resolver": [
      "^@hookform/resolvers/"
    ],
    "form-schema": [
      "^@standard-schema/"
    ],
    "form-date": [
      "^@fluentui/react-(datepicker|calendar)-compat/"
    ],
    "form-time": [
      "^@fluentui/react-timepicker-compat/"
    ],
    "data-grid": [
      "^@apvee/spfx-react-toolkit/lib/controls/data-grid/",
      "^@fluentui/react-table/"
    ],
    "charts": [
      "^@fluentui/(react-charts|chart-utilities)/"
    ],
    "d3": [
      "^(d3(?:-[^/]+)?|internmap)/"
    ],
    "grid-query": [
      "^@apvee/spfx-react-toolkit/lib/controls/(data-grid-view|data-grid-toolbar)/",
      "^@apvee/spfx-react-toolkit/lib/controls/data-grid/(?:.+/)?(?:data-grid-)?(?:view|toolbar|search|filters?|pagination|query|fetch|virtual)[^/]*\\.js$"
    ],
    "relative-time-control": [
      "^@apvee/spfx-react-toolkit/lib/controls/relative-time/relative-time\\.js$"
    ],
    "shell": [
      "^@apvee/spfx-react-toolkit/lib/controls/web-part-shell/"
    ],
    "editor": [
      "^@apvee/spfx-react-toolkit/lib/controls/web-part-shell/title/web-part-title-(editor(?:-adapter)?|extensions|toolbar)\\.internal\\.js$"
    ],
    "tiptap": [
      "^@tiptap/"
    ],
    "prosemirror": [
      "^prosemirror-[^/]+/"
    ],
    "editor-menus": [
      "^@tiptap/extension-(bubble|floating)-menu/"
    ],
    "shell-runtime": [
      "^@apvee/spfx-react-toolkit/lib/controls/web-part-shell/(?!web-part-shell-metadata\\.js$)"
    ]
  },
